@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		TestCase.setUpPortalInstance();

		task ("Given user with admin privileges and navigate to home page") {
			User.firstLoginPG();

			Navigator.openURL();
		}

		task ("Creating a page and adding a widget to the page") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Documents and Media Page");

			JSONLayout.addWidgetToPublicLayout(
				groupName = "Guest",
				layoutName = "Documents and Media Page",
				widgetName = "Documents and Media");
		}

		task ("Adding a document and accessing the page") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentDescription = "Document Description",
				dmDocumentTitle = "DMTest 1",
				groupName = "Guest",
				mimeType = "image/jpeg",
				sourceFileName = "Commerce_Black.jpg");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			DMDocument.tearDownCP();

			DMFolder.tearDownCP();

			PagesAdmin.openPagesAdmin(siteURLKey = "Guest");

			PagesAdmin.deletePage(pageName = "Documents and Media Page");

			User.logoutPG();
		}
	}

	@description = "Can Create a Documents and Media"
	@priority = 5
	test CanCreateDM {
		task ("When the user creates Documents and Media (Upload the file)") {
			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

			DMDocument.addCP(
				dmDocumentDescription = "Document Description",
				dmDocumentFile = "Commerce_Blue.jpg",
				dmDocumentTitle = "Document Test1");
		}

		task ("Accessing the Documents and Media page") {
			Navigator.gotoPage(pageName = "Documents and Media Page");
		}

		task ("Validating the documents and media created") {
			DMDocument.viewPG(dmDocumentTitle = "Document Test1");
		}
	}

	@description = "Can Delete a Documents and Media"
	@priority = 4
	test CanDeleteDM {
		task ("Creating another document and media and validating the creation of the two existing DMs") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentDescription = "Document Description",
				dmDocumentTitle = "DMTest 2",
				groupName = "Guest",
				mimeType = "image/jpeg",
				sourceFileName = "Commerce_Blue.jpg");

			DMDocument.viewPG(dmDocumentTitle = "DMTest 1");

			Click(locator1 = "Icon#BACK");

			DMDocument.viewPG(dmDocumentTitle = "DMTest 2");
		}

		task ("Accessing the Documents and Media Portlet and Deleting a DM") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Documents and Media",
				site = ${siteName});

			DMDocument.deleteCP(dmDocumentTitle = "DMTest 2");
		}

		task ("Validating that the excluded DM is not present and the DM is present") {
			DMDocument.cannotViewCP(dmDocumentTitle = "DMTest 2");

			DMDocument.viewPG(dmDocumentTitle = "DMTest 1");
		}
	}

	@description = "Can Edit a Documents and Media"
	@priority = 5
	test CanEditDM {
		task ("Editing the title and file of the document and media") {
			DMDocument.editCP(
				dmDocumentFileEdit = "Commerce_Blue.jpg",
				dmDocumentFileNameEdit = "Commerce_Blue.jpg",
				dmDocumentTitle = "DMTest 1",
				dmDocumentTitleEdit = "DMTest 2");
		}

		task ("Accessing the page and validating the change") {
			Navigator.gotoPage(pageName = "Documents and Media Page");

			DMDocument.viewPG(
				dmDocumentFileName = "Commerce_Blue.jpg",
				dmDocumentTitle = "DMTest 2");
		}
	}

}