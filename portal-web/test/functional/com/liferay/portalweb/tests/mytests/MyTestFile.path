<html>
<head>
<title>MyTestFile</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">MyTestFile</td></tr>
</thead>

<tbody>
<tr>
	<td>OPEN_SIMULATION</td>
	<td>//button[@data-qa-id='simulation']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOM_BUTTON</td>
	<td>//button[contains(@aria-controls,'Selector')]</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_WIDTH</td>
	<td>//input[contains(@id,'width')]</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_HEIGHT</td>
	<td>//input[contains(@id,'height')]</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_APPLY_CUSTOM</td>
	<td>//button[contains(text(),'Apply')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>