@component-name = "portal-web-forms-and-data-lists"
definition {

    property osgi.module.configuration.file.names = "com.liferay.frontend.js.loader.modules.extender.internal.configuration.Details.config";
	property osgi.module.configurations = "waitTimeout=\"15\"";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Forms";    

    setUp {
        TestCase.setUpPortalInstance();

        User.firstLoginPG();

        Navigator.openURL();
    }

    tearDown {
        User.logoutAndLoginPG(
            userLoginEmailAddress = "test@liferay.com",
            userLoginFullName = "Test Test");
    }

    @description = "Set Screen size to custom and validate values"
    @priority = "5"
    test SetScreenSizeAndValidateValues {

        //task (clicking on the simulation button, changing the screen size and validating the change)

        Click(locator1 = "//button[@data-qa-id='simulation']");

        Click(locator1 = "//button[contains(@aria-controls,'Selector')]");
        
        Click(locator1 = "//input[contains(@id,'width')]");

        Type.sendKeys(
			locator1 = "//input[contains(@id,'width')]",
			value1 = "keys=CONTROL,a");

        Type.sendKeys(
			locator1 = "//input[contains(@id,'width')]",
			value1 = 1920);

        Click(locator1 = "//input[contains(@id,'height')]");
        
        Type.sendKeys(
			locator1 = "//input[contains(@id,'height')]",
			value1 = "keys=CONTROL,a");

        Type.sendKeys(
			locator1 = "//input[contains(@id,'height')]",
			value1 = 1080);

        Click(locator1 = "//button[contains(text(),'Apply')]");

        Click(locator1 = "//button[contains(@class,'close')]");

        Click(locator1 = "//button[@data-qa-id='simulation']");

        Click(locator1 = "//button[contains(@aria-controls,'Selector')]");

        AssertTextEquals(
				locator1 = "//input[contains(@id,'width')]",
				value1 = "1090");

        AssertTextEquals(
				locator1 = "//input[contains(@id,'height')]",
				value1 = "1080");
        
    }
    }