definition {

	macro openCustomSimulation {
		Click(locator1 = "MyTestFile#OPEN_SIMULATION");

		Click(locator1 = "MyTestFile#CUSTOM_BUTTON");
	}

	macro editHeightSimulationPortlet {
		Click(locator1 = "MyTestFile#INPUT_HEIGHT");

		Type.sendKeys(
			locator1 = "MyTestFile#INPUT_HEIGHT",
			value1 = "keys=CONTROL,a");

		Type.sendKeys(
			locator1 = "MyTestFile#INPUT_HEIGHT",
			value1 = 1080);
	}
}