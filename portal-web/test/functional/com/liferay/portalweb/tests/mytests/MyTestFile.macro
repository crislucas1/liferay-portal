definition {

	macro editHeightSimulationPortlet {
		Click(locator1 = "MyTestFile#INPUT_HEIGHT");

		Type.sendKeys(
			locator1 = "MyTestFile#INPUT_HEIGHT",
			value1 = "keys=CONTROL,a");

		Type.sendKeys(
			locator1 = "MyTestFile#INPUT_HEIGHT",
			value1 = 1080);
	}

	macro editWidthSimulationPortlet {
		Click(locator1 = "MyTestFile#INPUT_WIDTH");

		Type.sendKeys(
			locator1 = "MyTestFile#INPUT_WIDTH",
			value1 = "keys=CONTROL,a");

		Type.sendKeys(
			locator1 = "MyTestFile#INPUT_WIDTH",
			value1 = 1920);
	}

	macro openCustomSimulation {
		Click(locator1 = "MyTestFile#OPEN_SIMULATION");

		Click(locator1 = "MyTestFile#CUSTOM_BUTTON");
	}

	macro saveScreenSizeChange {
		Click(locator1 = "MyTestFile#BUTTON_APPLY_CUSTOM");

		Click(locator1 = "MyTestFile#BUTTON_SIDENAV_CLOSE");
	}

	macro validateChangeInSimulationPortlet {
		AssertTextEquals(
			locator1 = "MyTestFile#INPUT_WIDTH",
			value1 = 1920);

		AssertTextEquals(
			locator1 = "MyTestFile#INPUT_HEIGHT",
			value1 = 1080);
	}

}