@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		task ("Given user with admin privileges and navigate to home page") {
			User.firstLoginPG();

			Navigator.openURL();
		}

		task ("Adding a page and add blog widget to public layout") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page");

			JSONLayout.addWidgetToPublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page",
				widgetName = "Blogs");
		}

		task ("Going to the page and adding a blog entry") {
			Navigator.gotoPage(pageName = "Blogs Page");

			BlogsNavigator.openToAddEntry(
				layoutName = "Blogs Page",
				siteURLKey = "guest");
		}

		task ("Creating and publishing a blog") {
			BlogsEntry.addTitle(entryTitle = "Blogs Entry Title");

			BlogsEntry.addContent(entryContent = "Blogs Entry Content");

			PortletEntry.publish();
		}

		task ("Go to the blogs page") {
			Navigator.gotoSitePage(
				pageName = "Blogs Page",
				siteName = "Guest");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}

		BlogsEntry.tearDownCP();

		PagesAdmin.openPagesAdmin(siteURLKey = "Guest");

		PagesAdmin.deletePage(pageName = "Blogs Page");
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanCreateBlog {
		task ("Validating the blog title and content") {
			BlogsEntry.viewEntryPG(
				entryContent = "Blogs Entry Content",
				entryTitle = "Blogs Entry Title");
		}
	}

	@description = "Check if it is possible to edit a blog"
	@priority = 5
	test CanEditBlog {
		task ("Accessing the edit tab and changing the title and content of the blog") {
			LexiconEntry.gotoVerticalEllipsisMenuItemNoError(menuItem = "Edit");

			BlogsEntry.editEntryContent(
				entryContent = "Blogs Entry Content",
				entryContentEdit = "Blogs Entry Content Edit",
				entryTitle = "Blogs Entry Title",
				entryTitleEdit = "Blogs Entry Title Edit");
		}

		task ("Publishing the blog and accessing the blogs page") {
			PortletEntry.publish();

			Navigator.gotoPage(pageName = "Blogs Page");
		}

		task ("Checking if the edit worked") {
			BlogsEntry.viewEntryPG(
				entryContent = "Blogs Entry Content Edit",
				entryTitle = "Blogs Entry Title Edit");
		}
	}

}